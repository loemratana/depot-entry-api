NODE_ENV=development
PORT=5000

# ---------- MongoDB ----------
# Used by docker-compose.yml to create the MongoDB root user on first start
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me
MONGODB_URI=mongodb://admin:change_me@127.0.0.1:27017/client_management?authSource=admin
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
# How long a request waits for a free pooled connection before a 503 (ms)
MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000
# Time limit for list/map/location queries and for export queries (ms); over it = 503
DB_QUERY_TIMEOUT_MS=15000
DB_EXPORT_QUERY_TIMEOUT_MS=120000

# ---------- HTTP ----------
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Set to 1 (number of proxies) or true when running behind a reverse proxy
TRUST_PROXY=false
# Business time zone for submission numbers, date filters and export (Cambodia)
APP_UTC_OFFSET=+07:00

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_long_random_secret
# Access token lifetime (jsonwebtoken format, e.g. 14d, 8h)
JWT_EXPIRES_IN=14d
# Refresh token lifetime in days; each refresh issues a new one (rotation)
REFRESH_TOKEN_EXPIRES_DAYS=30

# Initial admin created by `npm run seed:admin`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# ---------- MinIO ----------
# Also used by docker-compose.yml as the MinIO root credentials (secret must be 8+ chars)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=client-documents
MINIO_REGION=us-east-1
# Lifetime of presigned document URLs returned to admins
FILE_URL_EXPIRY_SECONDS=900

# ---------- Uploads ----------
MAX_FILES_PER_SUBMISSION=10
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
# Photos embedded in one Excel export are held in memory; above this total they are listed by name
EXPORT_MAX_IMAGE_MB=200
# Excel exports built at the same time (memory-heavy), how many more may wait, and how long (s)
EXPORT_CONCURRENCY=1
EXPORT_QUEUE_MAX=4
EXPORT_QUEUE_TIMEOUT_SECONDS=120

# ---------- Rate limits ----------
# Only failed logins are limited. Failed login attempts per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10

# Serve Swagger UI at /api/docs (defaults to true outside production)
SWAGGER_ENABLED=true
